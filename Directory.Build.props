<Project>
  <PropertyGroup>
    <!-- One version number, and nothing pinned beside it. The three stamps used to be written
         out by hand as well, and stayed a release behind from the moment this line changed:
         every copy of v0.7.26 was built saying it was v0.7.25, so the updater read the release
         list, found the release it was already running, and offered it again for ever. -->
    <Version>0.7.27</Version>
    <Authors>SerrebiProjects</Authors>
    <Product>BlindTerm</Product>
    <Company>SerrebiProjects</Company>
    <Copyright>Copyright (c) SerrebiProjects and contributors</Copyright>
    <!-- Allows dotnet restore/build of the Windows-targeted projects on Linux runners
         (NuGet dependency submission). No-op on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
</Project>
