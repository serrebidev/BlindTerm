<Project>
  <PropertyGroup>
    <Version>0.7.23</Version>
    <AssemblyVersion>0.7.23.0</AssemblyVersion>
    <FileVersion>0.7.23.0</FileVersion>
    <InformationalVersion>0.7.23</InformationalVersion>
    <Authors>SerrebiProjects</Authors>
    <Product>BlindTerm</Product>
